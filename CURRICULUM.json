{
  "program": "AI Learning Journey",
  "repository_name": "90-Days-of-AI",
  "philosophy": "90 days is Foundation Track 1, not the end. Advance by demonstrated mastery, with ongoing tracks added as the field evolves.",
  "foundation_90_days": [
    {
      "days": "1-10",
      "topic": "Python & computational thinking",
      "focus": [
        "Colab",
        "variables/types",
        "conditionals",
        "loops",
        "functions",
        "lists/dicts",
        "files",
        "errors/debugging",
        "modules",
        "mini-project"
      ],
      "milestone": "Build and explain a small Python program without copying a full solution."
    },
    {
      "days": "11-18",
      "topic": "Data literacy with NumPy, Pandas & visualization",
      "focus": [
        "arrays",
        "dataframes",
        "CSV/JSON",
        "cleaning",
        "filtering",
        "grouping",
        "statistics",
        "Matplotlib"
      ],
      "milestone": "Take a messy dataset from load to cleaned analysis and explain the choices."
    },
    {
      "days": "19-28",
      "topic": "Machine learning foundations",
      "focus": [
        "features/labels",
        "train/test",
        "regression",
        "classification",
        "trees",
        "metrics",
        "overfitting",
        "preprocessing",
        "scikit-learn",
        "model comparison"
      ],
      "milestone": "Train, evaluate and critique a small supervised ML model."
    },
    {
      "days": "29-36",
      "topic": "How modern generative AI works",
      "focus": [
        "neural-network intuition",
        "transformers",
        "tokens",
        "embeddings",
        "attention",
        "training vs inference",
        "context",
        "sampling",
        "multimodality"
      ],
      "milestone": "Explain an LLM pipeline in plain language and demonstrate token/context behavior."
    },
    {
      "days": "37-44",
      "topic": "Prompting, structured outputs & evaluation",
      "focus": [
        "instructions",
        "examples",
        "constraints",
        "structured JSON",
        "prompt injection basics",
        "hallucination",
        "rubrics",
        "test cases",
        "model comparison"
      ],
      "milestone": "Create and evaluate a reliable prompt workflow rather than judging one impressive response."
    },
    {
      "days": "45-53",
      "topic": "LLM APIs & application engineering",
      "focus": [
        "SDKs/HTTP",
        "secrets",
        "messages/state",
        "streaming",
        "structured output",
        "tool/function calling",
        "errors/retries",
        "cost/latency",
        "logging"
      ],
      "milestone": "Build a provider-aware command-line AI application with safe secret handling."
    },
    {
      "days": "54-62",
      "topic": "Embeddings, retrieval & RAG",
      "focus": [
        "embedding intuition",
        "similarity",
        "chunking",
        "metadata",
        "vector search",
        "hybrid retrieval",
        "grounding",
        "citations",
        "RAG evaluation"
      ],
      "milestone": "Build a document Q&A system and test whether answers are actually grounded."
    },
    {
      "days": "63-72",
      "topic": "Agents, tools & workflows",
      "focus": [
        "agent vs workflow",
        "tool schemas",
        "planning",
        "state",
        "memory",
        "human approval",
        "MCP concepts",
        "agent evaluation",
        "security",
        "LangGraph or equivalent"
      ],
      "milestone": "Build a tool-using workflow/agent with explicit guardrails and tests."
    },
    {
      "days": "73-80",
      "topic": "Automation & integrations",
      "focus": [
        "webhooks",
        "REST APIs",
        "scheduled jobs",
        "email/files/spreadsheets",
        "Make/Zapier/n8n concepts",
        "permissions",
        "idempotency",
        "failure recovery"
      ],
      "milestone": "Automate a useful multi-step workflow with safe human checkpoints."
    },
    {
      "days": "81-90",
      "topic": "Production capstone",
      "focus": [
        "problem framing",
        "architecture",
        "UI",
        "testing",
        "evaluation dataset",
        "privacy/security",
        "deployment",
        "monitoring",
        "documentation",
        "demo/retrospective"
      ],
      "milestone": "Ship and explain a complete AI application with tests, evaluation and documentation."
    }
  ],
  "ongoing_tracks": [
    {
      "track": "A",
      "title": "AI Engineering",
      "topics": [
        "advanced RAG",
        "search/reranking",
        "agent architectures",
        "MCP/tool ecosystems",
        "observability",
        "evals",
        "security",
        "performance/cost"
      ]
    },
    {
      "track": "B",
      "title": "Machine Learning & Deep Learning",
      "topics": [
        "math foundations",
        "PyTorch",
        "neural networks",
        "CNNs",
        "transformers from deeper principles",
        "fine-tuning",
        "experimentation"
      ]
    },
    {
      "track": "C",
      "title": "Data & MLOps",
      "topics": [
        "SQL",
        "data pipelines",
        "Docker",
        "cloud fundamentals",
        "model serving",
        "CI/CD",
        "monitoring",
        "versioning"
      ]
    },
    {
      "track": "D",
      "title": "Multimodal & Generative Media",
      "topics": [
        "vision",
        "speech",
        "image generation",
        "video",
        "multimodal retrieval",
        "responsible media generation"
      ]
    },
    {
      "track": "E",
      "title": "AI Product & Automation",
      "topics": [
        "workflow design",
        "no-code/low-code",
        "product discovery",
        "human-in-the-loop",
        "business process automation",
        "ROI and reliability"
      ]
    },
    {
      "track": "F",
      "title": "Research & Frontier Learning",
      "topics": [
        "reading papers",
        "reproducing results",
        "benchmarks",
        "open-source models",
        "new architectures",
        "continuous technology updates"
      ]
    }
  ]
}
